{
  "name": "dsh-hybrid-notify",
  "version": "0.2.1",
  "description": "Multi-channel notification plugin for DeepSeek Harness — in-page toasts, PWA system notifications and browser notifications, with Web Audio synthesized sounds and per-event toggles. dsh-hybrid-notify：DeepSeek Harness 多通道通知插件——按窗口可见性自动切换页面内 toast / PWA 系统通知 / 浏览器通知，附带 Web Audio 合成音效与事件级开关。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "cordis",
    "plugin",
    "notify",
    "notification",
    "toast",
    "pwa",
    "browser-notification",
    "sound",
    "deepseek-harness",
    "通知",
    "提醒"
  ],
  "license": "MIT",
  "author": "johnnren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-walks-slow/dsh-hybrid-notify.git"
  },
  "bugs": {
    "url": "https://github.com/john-walks-slow/dsh-hybrid-notify/issues"
  },
  "homepage": "https://github.com/john-walks-slow/dsh-hybrid-notify#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "typescript": "^5.9.3",
    "esbuild": "^0.28.2"
  }
}
